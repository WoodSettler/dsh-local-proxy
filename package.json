{
  "name": "dsh-local-proxy",
  "version": "1.0.1",
  "description": "DSH plugin: discover this machine's HTTP proxy (proxy env vars, else the Windows system proxy) and make DSH use it — for the agent's in-process fetches and for every child process it spawns.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WoodSettler/dsh-local-proxy.git"
  },
  "homepage": "https://github.com/WoodSettler/dsh-local-proxy#readme",
  "bugs": {
    "url": "https://github.com/WoodSettler/dsh-local-proxy/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "proxy",
    "http-proxy"
  ],
  "engines": {
    "node": ">=20"
  }
}
